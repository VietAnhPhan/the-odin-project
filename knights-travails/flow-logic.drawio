        <mxCell id="u51uzEtMC7baKAof4C2t-6" value="+ field: x, y , prev" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="u51uzEtMC7baKAof4C2t-5">
